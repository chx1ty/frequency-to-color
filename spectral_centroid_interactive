<html>
<head>
<style>
body { font-family: var(--font-sans); padding: 1rem; background: transparent; }
.container { max-width: 680px; margin: 0 auto; }
.header { text-align: center; margin-bottom: 2rem; }
.header h2 { font-size: 18px; font-weight: 500; margin: 0 0 0.5rem 0; }
.header p { font-size: 13px; color: var(--color-text-secondary); margin: 0; }

.control-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 2rem; }
.slider-group { padding: 1rem; background: var(--color-background-secondary); border-radius: var(--border-radius-md); }
.slider-label { font-size: 13px; font-weight: 500; margin-bottom: 8px; color: var(--color-text-primary); }
.slider-value { font-size: 14px; font-weight: 500; color: var(--color-text-info); margin-top: 4px; }
input[type="range"] { width: 100%; height: 6px; cursor: pointer; }

.spectrum-bar { height: 80px; border-radius: var(--border-radius-md); border: 0.5px solid var(--color-border-tertiary); margin-bottom: 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); position: relative; overflow: hidden; }
.spectrum-indicator { position: absolute; top: 0; width: 2px; height: 100%; background: rgba(0,0,0,0.3); z-index: 10; }
.spectrum-labels { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; margin-bottom: 1rem; }
.spectrum-label { font-size: 11px; text-align: center; color: var(--color-text-secondary); }

.sphere-display { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 2rem; }
.sphere-container { flex: 0 0 120px; }
.sphere { width: 120px; height: 120px; border-radius: 50%; box-shadow: 0 0 0 1px var(--color-border-tertiary), 0 8px 24px rgba(0,0,0,0.15); }
.sphere-info { flex: 1; padding: 1rem; background: var(--color-background-secondary); border-radius: var(--border-radius-md); }
.info-row { display: grid; grid-template-columns: 80px 1fr; gap: 16px; margin: 10px 0; font-size: 13px; }
.info-label { color: var(--color-text-secondary); font-weight: 500; }
.info-value { color: var(--color-text-primary); font-family: var(--font-mono); }

.color-spectrum { margin-bottom: 2rem; }
.spectrum-title { font-size: 14px; font-weight: 500; margin-bottom: 8px; }

.preset-buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 2rem; }
.preset-btn { padding: 10px; border: 0.5px solid var(--color-border-secondary); background: var(--color-background-secondary); border-radius: var(--border-radius-md); cursor: pointer; font-size: 12px; font-weight: 500; transition: all 0.2s; }
.preset-btn:hover { background: var(--color-background-tertiary); border-color: var(--color-border-primary); }
.preset-btn.active { background: var(--color-text-info); color: white; border-color: var(--color-text-info); }

.comparison-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 2rem; }
.comparison-table td { padding: 10px; border-bottom: 0.5px solid var(--color-border-tertiary); }
.comparison-table td:first-child { color: var(--color-text-secondary); width: 35%; }
.comparison-table td:nth-child(2) { color: var(--color-text-info); font-weight: 500; width: 25%; }
.comparison-table td:nth-child(3) { text-align: center; width: 20%; }
.comparison-table td:nth-child(4) { color: var(--color-text-secondary); font-size: 11px; }

.formula-section { padding: 1rem; background: var(--color-background-secondary); border-radius: var(--border-radius-md); margin-bottom: 2rem; font-family: var(--font-mono); font-size: 12px; }
.formula-line { margin: 6px 0; }

.frequency-scale { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; margin-bottom: 2rem; }
.freq-box { padding: 12px; background: var(--color-background-secondary); border-radius: var(--border-radius-md); text-align: center; border: 0.5px solid var(--color-border-tertiary); }
.freq-hz { font-size: 11px; color: var(--color-text-secondary); margin-bottom: 4px; }
.freq-color { width: 100%; height: 30px; border-radius: 4px; margin-bottom: 4px; }
.freq-name { font-size: 11px; color: var(--color-text-primary); font-weight: 500; }
</style>
</head>
<body>

<div class="container">
  <div class="header">
    <h2>頻率到顏色轉換 (修正版)</h2>
    <p>20Hz (紅) → 20kHz (紫) - 正確的對數映射</p>
  </div>

  <!-- 控制面板 -->
  <div class="control-panel">
    <div class="slider-group">
      <div class="slider-label">頻譜質心 (SC)：</div>
      <input type="range" id="scSlider" min="20" max="20000" value="1000" step="5" style="width: 100%;">
      <div class="slider-value"><span id="scValue">1000</span> Hz</div>
    </div>
    <div class="slider-group">
      <div class="slider-label">飽和度 (Saturation)：</div>
      <input type="range" id="satSlider" min="0" max="100" value="85" step="1" style="width: 100%;">
      <div class="slider-value"><span id="satValue">85</span>%</div>
    </div>
  </div>

  <!-- 色譜條 -->
  <div class="color-spectrum">
    <div class="spectrum-title">完整色譜映射 (20Hz - 20kHz)：</div>
    <div class="spectrum-bar" id="spectrumBar">
      <div class="spectrum-indicator" id="spectrumIndicator"></div>
    </div>
    <div class="spectrum-labels">
      <div class="spectrum-label">20Hz<br>🔴 紅</div>
      <div class="spectrum-label">100Hz<br>橙</div>
      <div class="spectrum-label">500Hz<br>黃</div>
      <div class="spectrum-label">2kHz<br>綠</div>
      <div class="spectrum-label">5kHz<br>青</div>
      <div class="spectrum-label">8kHz<br>藍</div>
      <div class="spectrum-label">12kHz<br>靛</div>
      <div class="spectrum-label">20kHz<br>🟣 紫</div>
    </div>
  </div>

  <!-- 光球顯示 -->
  <div class="sphere-display">
    <div class="sphere-container">
      <div class="sphere" id="sphereColor"></div>
    </div>
    <div class="sphere-info">
      <div class="info-row">
        <div class="info-label">頻率：</div>
        <div class="info-value"><span id="infoFreq">1000</span> Hz</div>
      </div>
      <div class="info-row">
        <div class="info-label">色調 (H)：</div>
        <div class="info-value"><span id="infoHue">180</span>°</div>
      </div>
      <div class="info-row">
        <div class="info-label">飽和度 (S)：</div>
        <div class="info-value"><span id="infoSat">85</span>%</div>
      </div>
      <div class="info-row">
        <div class="info-label">亮度 (L)：</div>
        <div class="info-value">50%</div>
      </div>
      <div class="info-row">
        <div class="info-label">RGB：</div>
        <div class="info-value"><span id="infoRGB">rgb(0, 255, 255)</span></div>
      </div>
      <div class="info-row">
        <div class="info-label">顏色名稱：</div>
        <div class="info-value"><span id="colorName">青色</span></div>
      </div>
    </div>
  </div>

  <!-- 預設按鈕 -->
  <div>
    <div style="font-size: 13px; font-weight: 500; margin-bottom: 8px;">快速預設：</div>
    <div class="preset-buttons">
      <button class="preset-btn" onclick="setPreset(20)">超低頻<br>(20 Hz)</button>
      <button class="preset-btn" onclick="setPreset(80)">男性深沈<br>(80 Hz)</button>
      <button class="preset-btn" onclick="setPreset(250)">男性標準<br>(250 Hz)</button>
      <button class="preset-btn" onclick="setPreset(600)">標準語音<br>(600 Hz)</button>
      <button class="preset-btn" onclick="setPreset(1200)">女性語音<br>(1.2k Hz)</button>
      <button class="preset-btn" onclick="setPreset(2500)">兒童<br>(2.5k Hz)</button>
      <button class="preset-btn" onclick="setPreset(8000)">高頻<br>(8k Hz)</button>
      <button class="preset-btn" onclick="setPreset(20000)">超高頻<br>(20k Hz)</button>
    </div>
  </div>

  <!-- 頻率色彩快速參考 -->
  <div>
    <div style="font-size: 14px; font-weight: 500; margin-bottom: 1rem;">頻率色彩映射表：</div>
    <table class="comparison-table">
      <tr style="border-bottom: 1px solid var(--color-border-secondary);">
        <td style="font-weight: 500;">頻率範圍</td>
        <td style="font-weight: 500;">色調</td>
        <td style="font-weight: 500;">樣本</td>
        <td style="font-weight: 500;">常見聲音</td>
      </tr>
      <tr>
        <td>20-50 Hz</td>
        <td>0° (紅)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(0, 85%, 50%); border-radius: 3px;"></div></td>
        <td>超低音</td>
      </tr>
      <tr>
        <td>50-100 Hz</td>
        <td>15° (紅)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(15, 85%, 50%); border-radius: 3px;"></div></td>
        <td>低音提琴</td>
      </tr>
      <tr>
        <td>100-200 Hz</td>
        <td>30° (橙)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(30, 85%, 50%); border-radius: 3px;"></div></td>
        <td>男性低音</td>
      </tr>
      <tr>
        <td>200-350 Hz</td>
        <td>45° (橙)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(45, 85%, 50%); border-radius: 3px;"></div></td>
        <td>男性中低音</td>
      </tr>
      <tr>
        <td>350-550 Hz</td>
        <td>60° (黃)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(60, 85%, 50%); border-radius: 3px;"></div></td>
        <td>男性標準語音</td>
      </tr>
      <tr>
        <td>550-1000 Hz</td>
        <td>90° (黃綠)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(90, 85%, 50%); border-radius: 3px;"></div></td>
        <td>標準語音</td>
      </tr>
      <tr>
        <td>1000-2000 Hz</td>
        <td>120° (綠)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(120, 85%, 50%); border-radius: 3px;"></div></td>
        <td>女性語音</td>
      </tr>
      <tr>
        <td>2000-4000 Hz</td>
        <td>150° (春綠)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(150, 85%, 50%); border-radius: 3px;"></div></td>
        <td>兒童語音</td>
      </tr>
      <tr>
        <td>4000-7000 Hz</td>
        <td>180° (青)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(180, 85%, 50%); border-radius: 3px;"></div></td>
        <td>尖銳聲、蛇聲</td>
      </tr>
      <tr>
        <td>7000-10000 Hz</td>
        <td>210° (青藍)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(210, 85%, 50%); border-radius: 3px;"></div></td>
        <td>高頻細節</td>
      </tr>
      <tr>
        <td>10000-15000 Hz</td>
        <td>240° (藍)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(240, 85%, 50%); border-radius: 3px;"></div></td>
        <td>極高頻</td>
      </tr>
      <tr>
        <td>15000-20000 Hz</td>
        <td>270° (靛紫)</td>
        <td><div style="width: 20px; height: 20px; background: hsl(270, 85%, 50%); border-radius: 3px;"></div></td>
        <td>超高頻尖刺</td>
      </tr>
    </table>
  </div>

  <!-- 計算公式 -->
  <div>
    <div style="font-size: 14px; font-weight: 500; margin: 2rem 0 1rem 0;">轉換公式：</div>
    <div class="formula-section">
      <div style="margin-bottom: 8px;"><strong>對數頻率映射 (20Hz → 0°, 20kHz → 270°)</strong></div>
      <div class="formula-line">log_freq = log₂(SC / 20) = log₂(<span id="formula1">50</span>) ≈ <span id="formula2">5.64</span></div>
      <div class="formula-line">log_max = log₂(20000 / 20) = log₂(1000) ≈ 9.97</div>
      <div class="formula-line">normalized = log_freq / log_max = <span id="formula3">0.565</span></div>
      <div class="formula-line">hue = normalized × 270° = <span id="formula4">152°</span></div>
      <div style="margin-top: 12px;"><strong>轉換為RGB</strong></div>
      <div class="formula-line">HSL(<span id="formula5">152</span>°, <span id="formula6">85</span>%, 50%) = <span id="formula7">rgb(0, 255, 140)</span></div>
    </div>
  </div>

  <!-- 視覺參考網格 -->
  <div>
    <div style="font-size: 14px; font-weight: 500; margin-bottom: 1rem;">頻率-色彩網格參考：</div>
    <div class="frequency-scale" id="freqScale"></div>
  </div>
</div>

<script>
const scSlider = document.getElementById('scSlider');
const satSlider = document.getElementById('satSlider');
const sphere = document.getElementById('sphereColor');

// 精準的12段色調定義
const colorSegments = [
  { freq_min: 20, freq_max: 50, name: '超低紅', hue: 0 },
  { freq_min: 50, freq_max: 100, name: '深紅', hue: 15 },
  { freq_min: 100, freq_max: 200, name: '紅', hue: 30 },
  { freq_min: 200, freq_max: 350, name: '橙紅', hue: 45 },
  { freq_min: 350, freq_max: 550, name: '橙黃', hue: 60 },
  { freq_min: 550, freq_max: 1000, name: '黃綠', hue: 90 },
  { freq_min: 1000, freq_max: 2000, name: '綠', hue: 120 },
  { freq_min: 2000, freq_max: 4000, name: '春綠', hue: 150 },
  { freq_min: 4000, freq_max: 7000, name: '青', hue: 180 },
  { freq_min: 7000, freq_max: 10000, name: '青藍', hue: 210 },
  { freq_min: 10000, freq_max: 15000, name: '藍', hue: 240 },
  { freq_min: 15000, freq_max: 20000, name: '靛紫', hue: 270 }
];

function hslToRgb(h, s, l) {
  s /= 100; l /= 100;
  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
  const m = l - c / 2;
  let r, g, b;

  if (h >= 0 && h < 60) { r = c; g = x; b = 0; }
  else if (h >= 60 && h < 120) { r = x; g = c; b = 0; }
  else if (h >= 120 && h < 180) { r = 0; g = c; b = x; }
  else if (h >= 180 && h < 240) { r = 0; g = x; b = c; }
  else if (h >= 240 && h < 300) { r = x; g = 0; b = c; }
  else { r = c; g = 0; b = x; }

  r = Math.round((r + m) * 255);
  g = Math.round((g + m) * 255);
  b = Math.round((b + m) * 255);

  return [r, g, b];
}

function rgbToString(rgb) {
  return `rgb(${rgb[0]}, ${rgb[1]}, ${rgb[2]})`;
}

function frequencyToHue(freq) {
  // 對數映射：20Hz → 0°, 20kHz → 270°
  const logFreq = Math.log2(Math.max(freq, 20) / 20);
  const logMax = Math.log2(20000 / 20);  // ≈ 9.97
  const normalized = Math.max(0, Math.min(1, logFreq / logMax));
  return normalized * 270;  // 只用0-270°，不是0-360°
}

function updateDisplay() {
  const sc = parseFloat(scSlider.value);
  const sat = parseFloat(satSlider.value);
  const light = 50;
  const hue = frequencyToHue(sc);

  // 更新輸入顯示
  document.getElementById('scValue').textContent = Math.round(sc);
  document.getElementById('satValue').textContent = sat;

  // 找到顏色段
  const colorInfo = colorSegments.find(seg => sc >= seg.freq_min && sc < seg.freq_max) || colorSegments[11];

  // 計算RGB
  const rgb = hslToRgb(hue, sat, light);
  const rgbStr = rgbToString(rgb);

  // 更新光球
  sphere.style.backgroundColor = `hsl(${hue}, ${sat}%, ${light}%)`;
  sphere.style.boxShadow = `0 0 0 1px var(--color-border-tertiary), 0 8px 24px ${rgbStr}40`;

  // 更新信息面板
  document.getElementById('infoFreq').textContent = Math.round(sc);
  document.getElementById('infoHue').textContent = Math.round(hue);
  document.getElementById('infoSat').textContent = sat;
  document.getElementById('infoRGB').textContent = rgbStr;
  document.getElementById('colorName').textContent = colorInfo.name;

  // 更新公式
  const logFreq = Math.log2(Math.max(sc, 20) / 20);
  const logMax = Math.log2(20000 / 20);
  const normalized = Math.max(0, Math.min(1, logFreq / logMax));
  document.getElementById('formula1').textContent = (Math.max(sc, 20) / 20).toFixed(1);
  document.getElementById('formula2').textContent = logFreq.toFixed(2);
  document.getElementById('formula3').textContent = normalized.toFixed(3);
  document.getElementById('formula4').textContent = Math.round(hue);
  document.getElementById('formula5').textContent = Math.round(hue);
  document.getElementById('formula6').textContent = sat;
  document.getElementById('formula7').textContent = rgbStr;

  // 更新色譜條
  const spectrumBar = document.getElementById('spectrumBar');
  spectrumBar.style.background = `linear-gradient(to right, 
    hsl(0, 85%, 50%) 0%, 
    hsl(15, 85%, 50%) 8.3%,
    hsl(30, 85%, 50%) 16.7%,
    hsl(45, 85%, 50%) 25%,
    hsl(60, 85%, 50%) 33.3%,
    hsl(90, 85%, 50%) 41.7%,
    hsl(120, 85%, 50%) 50%,
    hsl(150, 85%, 50%) 58.3%,
    hsl(180, 85%, 50%) 66.7%,
    hsl(210, 85%, 50%) 75%,
    hsl(240, 85%, 50%) 83.3%,
    hsl(270, 85%, 50%) 100%)`;
  
  // 計算當前位置指示
  const posPercent = (normalized * 100);
  document.getElementById('spectrumIndicator').style.left = posPercent + '%';
}

// 初始化頻率網格
function initFreqScale() {
  const container = document.getElementById('freqScale');
  container.innerHTML = '';
  const freqs = [20, 100, 500, 1000, 2500, 5000, 10000, 20000];
  
  freqs.forEach(freq => {
    const hue = frequencyToHue(freq);
    const box = document.createElement('div');
    box.className = 'freq-box';
    box.style.cursor = 'pointer';
    box.style.transition = 'all 0.2s';
    box.onclick = () => {
      scSlider.value = freq;
      updateDisplay();
    };
    
    const colorInfo = colorSegments.find(seg => freq >= seg.freq_min && freq < seg.freq_max);
    
    box.innerHTML = `
      <div class="freq-hz">${freq > 1000 ? (freq/1000).toFixed(1) + 'k' : freq} Hz</div>
      <div class="freq-color" style="background: hsl(${hue}, 85%, 50%);"></div>
      <div class="freq-name">${colorInfo ? colorInfo.name : '紫'}</div>
    `;
    box.onmouseenter = () => box.style.transform = 'scale(1.05)';
    box.onmouseleave = () => box.style.transform = 'scale(1)';
    
    container.appendChild(box);
  });
}

function setPreset(freq) {
  scSlider.value = freq;
  updateDisplay();
  
  // 更新預設按鈕視覺反饋
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.classList.remove('active');
    if (btn.textContent.includes(freq > 1000 ? (freq/1000).toFixed(0) : freq)) {
      btn.classList.add('active');
    }
  });
}

scSlider.addEventListener('input', updateDisplay);
satSlider.addEventListener('input', updateDisplay);

initFreqScale();
updateDisplay();
</script>
</body>
</html>
